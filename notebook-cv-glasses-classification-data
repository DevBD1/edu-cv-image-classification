    "DATASET_PATH = Path(\"/kaggle/input/datasets/ashfakyeafi/glasses-classification-dataset\")\n",
    "\n",
    "print(os.listdir(DATASET_PATH))\n",
    "\n",
    "print(\"\\n--- Sınıf sayıları ---\")\n",
