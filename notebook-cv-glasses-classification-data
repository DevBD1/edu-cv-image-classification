    "\n",
    "    items = list(split_path.iterdir())\n",
    "    print(\"ilk elemanlar:\", [x.name for x in items[:10]])\n",
    "\n",
    "    class_dirs = [x for x in items if x.is_dir()]\n",
    "    if class_dirs:\n",
    "        for cls in class_dirs:\n",
