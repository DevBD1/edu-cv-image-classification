    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.metrics import confusion_matrix, ConfusionMatrixDisplay, classification_report\n",
    "\n",
    "class_names = ['glasses', 'noglasses']\n",
    "\n",
    "labels = []\n",
    "probs = []\n",
    "\n",
    "for batch_images, batch_labels in val_ds_tl:\n",
    "    batch_probs = crop_model.predict(batch_images, verbose=0).ravel()\n",
    "    labels.extend(batch_labels.numpy().ravel())\n",
    "    probs.extend(batch_probs)\n",
    "\n",
    "labels = np.array(labels).astype(int)\n",
    "probs = np.array(probs)\n",
    "preds = (probs >= 0.5).astype(int)\n",
    "\n",
    "print(classification_report(labels, preds, target_names=class_names))\n",
    "\n",
    "cm = confusion_matrix(labels, preds)\n",
    "print(\"Confusion Matrix:\\n\", cm)\n",
    "\n",
    "disp = ConfusionMatrixDisplay(confusion_matrix=cm, display_labels=class_names)\n",
    "fig, ax = plt.subplots(figsize=(5, 5))\n",
    "disp.plot(ax=ax, cmap=\"Blues\", colorbar=False)\n",
    "plt.title(\"Validation Confusion Matrix - Cropped Fine-Tuned Model\")\n",
    "plt.show()"
   ]
